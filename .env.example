# Use `npm run dev:demo` to preview sample onboarding locally.
# Production mode requires the public Supabase URL and publishable key below.
VITE_APP_MODE=production
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SERVICE_TERMS_STATUS=unapproved
VITE_SERVICE_TERMS_VERSION=
VITE_PRIVACY_NOTICE_STATUS=unapproved
VITE_PRIVACY_NOTICE_VERSION=

# Configure these in the Supabase project before enabling checkout.
# VAT treatment and AI/messaging allowances are intentionally not guessed.
# Paystack is the selected payment provider. Keep its secret and webhook
# signing credentials in the server-side function environment, never VITE_*.
PAYSTACK_SECRET_KEY=
# Optional when using Paystack's newer timestamped Paystack-Signature header.
PAYSTACK_WEBHOOK_SECRET=
