# Use `npm run dev:demo` to preview sample onboarding locally.
# Production mode requires the public Supabase URL and publishable key below.
VITE_APP_MODE=production
VITE_CLERK_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SERVICE_TERMS_STATUS=unapproved
VITE_SERVICE_TERMS_VERSION=
VITE_PRIVACY_NOTICE_STATUS=unapproved
VITE_PRIVACY_NOTICE_VERSION=

# Configure these in the Supabase project before enabling checkout.
# VAT treatment and AI/messaging allowances are intentionally not guessed.
# Paystack is the selected payment provider. Keep its secret and webhook
# signing credentials in the server-side function environment, never VITE_*.
PAYSTACK_SECRET_KEY=
# Optional when using Paystack's newer timestamped Paystack-Signature header.
PAYSTACK_WEBHOOK_SECRET=

# Server-side function settings. Keep these in Supabase Edge Function secrets
# (or the private local function environment), never in VITE_* variables.
CLERK_SECRET_KEY=
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_JWT_AUDIENCE=
MOTORSTACK_SUPABASE_SECRET_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_ALLOWED_ORIGINS=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173

# MotorStack Assistant Edge Function only. Never prefix these with VITE_.
# Qwen 3.8 27B is currently a Groq preview model. Review availability before launch.
# Llama 3.3 70B requires Groq Enterprise access with a committed-spend contract.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Use a Supabase secret API key (sb_secret_...) for server functions.
# SUPABASE_ is reserved for platform-provided Edge Function variables.
# At least 24 random characters; used to hash visitor IPs for hourly limits.
ASSISTANT_RATE_LIMIT_SALT=
